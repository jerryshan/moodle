# ~/pokemoodle/prod.env  (never commit the real file)
COMPOSE_PROJECT_NAME=pokemoodle
IMAGE_TAG=prod

POSTGRES_DB=moodle
POSTGRES_USER=moodle
POSTGRES_PASSWORD=change-me-prod

# VM LAN address + a free port. Caddy (Proxmox LXC) connects here.
WEB_BIND=192.168.1.156
WEB_PORT=8082

MOODLE_WWWROOT=https://pokemoodle.geminitech.co.nz
MOODLE_SSLPROXY=true
MOODLE_REVERSEPROXY=true
