# Add to the Caddyfile in the Caddy LXC, then: caddy validate && systemctl reload caddy
# gemini-home VM LAN IP: 192.168.1.156 (same as WEB_BIND).
# Caddy sends X-Forwarded-For/Proto/Host itself; Moodle is told to trust it via
# MOODLE_SSLPROXY / MOODLE_REVERSEPROXY.

pokemoodle-test.geminitech.co.nz {
	encode zstd gzip
	request_body {
		max_size 512MB
	}
	reverse_proxy 192.168.1.156:8081 {
		transport http {
			response_header_timeout 300s
		}
	}
}

pokemoodle.geminitech.co.nz {
	encode zstd gzip
	request_body {
		max_size 512MB
	}
	reverse_proxy 192.168.1.156:8082 {
		transport http {
			response_header_timeout 300s
		}
	}
}
