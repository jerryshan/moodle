# Copy to .env and fill in
POSTGRES_PASSWORD=change-me
POSTGRES_DB=moodle
POSTGRES_USER=moodle

# Host address + port Apache listens on. Caddy runs in a separate Proxmox LXC,
# so on the VM set WEB_BIND to the VM's LAN IP (not 127.0.0.1) and firewall the
# port to the Caddy LXC only. Pick a port not used by other containers.
WEB_BIND=127.0.0.1
WEB_PORT=8080

# Public URL users will browse to, no trailing slash
MOODLE_WWWROOT=https://pokemoodle-test.geminitech.co.nz
# Set both to true if behind an HTTPS reverse proxy
MOODLE_SSLPROXY=true
MOODLE_REVERSEPROXY=true
